NODE_ENV=development
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
# Local Prisma Postgres (development only). For Docker use your isolated PostgreSQL URL.
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
ALLOW_REGISTRATION=true
TRUST_PROXY=false
SESSION_TTL_HOURS=24
# Optional external services; never put tokens in NEXT_PUBLIC_* variables.
REDIS_URL=
OPENAI_API_KEY=
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
N8N_BASE_URL=
N8N_API_KEY=

OPENAI_MODEL=
# Optional USD prices per million tokens; set from the chosen model contract.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
AI_DAILY_TOKEN_LIMIT=50000
# Discovery requests are reused by query on the same day and capped per workspace.
SUPPLIER_DISCOVERY_DAILY_LIMIT=3
# Reserved for the future DSLite connector. Leave empty until DSLite authorizes the account.
DSLITE_API_BASE_URL=https://api.dslite.com.br
DSLITE_API_KEY=
DSLITE_CATALOG_URL=
# Generate 32 random bytes, base64, for OAuth secrets; preserve this key across deployments.
ENCRYPTION_KEY=
INTERNAL_SERVICE_KEY=
N8N_SERVICE_TOKEN=
MERCADOLIVRE_REDIRECT_URI=
MERCADOLIVRE_NOTIFICATION_TOKEN=
N8N_PUBLIC_URL=
