{
  "name": "marketpilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @marketpilot/api\" \"npm run dev -w @marketpilot/web\"",
    "build": "npm run db:generate && npm run build -w @marketpilot/api && npm run build -w @marketpilot/web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p apps/api/tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --config packages/database/prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config packages/database/prisma.config.ts",
    "db:local": "prisma dev --name marketpilot --detach",
    "db:local:stop": "prisma dev stop marketpilot",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run db:generate && npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.2.0",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "concurrently": "^9.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.5",
    "prettier": "^3.9.10",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
