generator client {
  provider = "prisma-client"
  output = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  timezone  String   @default("America/Sao_Paulo")
  createdAt DateTime @default(now())
  users     User[]
  auditLogs AuditLog[]
  suppliers Supplier[]
  products Product[]
  catalogImports CatalogImport[]
  costSnapshots CostSnapshot[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(ADMIN)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  sessions     Session[]
  auditLogs    AuditLog[]
  catalogImports CatalogImport[]
  @@index([workspaceId])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id          String    @id @default(uuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action      String
  createdAt   DateTime  @default(now())
  @@index([workspaceId, createdAt])
}

enum CatalogStatus {
  ACTIVE
  ARCHIVED
}
enum CatalogSource {
  MANUAL
  CSV
  XML
}
enum CatalogFormat {
  CSV
  XML
}
model Supplier {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name String
  cnpj String?
  contactName String?
  email String?
  phone String?
  sourceUrl String?
  notes String?
  shippingDays Int @default(2)
  shippingCostCents Int @default(0)
  rating Int @default(0)
  status CatalogStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products Product[]
  imports CatalogImport[]
  @@unique([id, workspaceId])
  @@index([workspaceId, status])
}
model Product {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierId String
  supplier Supplier @relation(fields: [supplierId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  sku String
  name String
  category String @default("Sem categoria")
  costCents Int
  stock Int
  shippingDays Int @default(2)
  shippingCostCents Int @default(0)
  sourceUrl String?
  source CatalogSource @default(MANUAL)
  status CatalogStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  history CostSnapshot[]
  @@unique([workspaceId, supplierId, sku])
  @@unique([id, workspaceId])
  @@index([workspaceId, status, updatedAt])
}
model CatalogImport {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  supplierId String
  supplier Supplier @relation(fields: [supplierId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  actorId String?
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  fileName String
  fileHash String
  format CatalogFormat
  totalRows Int
  createdCount Int @default(0)
  updatedCount Int @default(0)
  unchangedCount Int @default(0)
  createdAt DateTime @default(now())
  @@unique([workspaceId, supplierId, fileHash])
  @@index([workspaceId, createdAt])
}
model CostSnapshot {
  id String @id @default(uuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  productId String
  product Product @relation(fields: [productId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  costCents Int
  stock Int
  shippingDays Int
  shippingCostCents Int
  source CatalogSource
  sourceUrl String?
  createdAt DateTime @default(now())
  @@index([workspaceId, productId, createdAt])
}
