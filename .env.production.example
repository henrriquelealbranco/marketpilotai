# Copy to .env.production, keep private; all secrets below are intentionally empty.
MARKETPILOT_PROJECT_NAME=marketpilot
MARKETPILOT_VERSION=0.3.0
APP_ORIGIN=https://marketpilot.example.com
ALLOW_REGISTRATION=false
MARKETPILOT_WEB_PORT=3100
MARKETPILOT_N8N_PORT=5679
POSTGRES_ADMIN_PASSWORD=
MARKETPILOT_DB_PASSWORD=
N8N_DB_PASSWORD=
REDIS_PASSWORD=
# Independent, random 32+ character keys, never reused.
INTERNAL_SERVICE_KEY=
N8N_SERVICE_TOKEN=
N8N_ENCRYPTION_KEY=
# Exactly 32 random bytes encoded as base64.
ENCRYPTION_KEY=
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.46.6
N8N_HOST=n8n-marketpilot.example.com
N8N_EDITOR_BASE_URL=https://n8n-marketpilot.example.com/
N8N_PUBLIC_API_DISABLED=true
N8N_API_KEY=
WORKER_CONCURRENCY=2
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
AI_DAILY_TOKEN_LIMIT=50000
SUPPLIER_DISCOVERY_DAILY_LIMIT=3
# Reserved only; do not add credentials until DSLite grants API access and catalog URL.
DSLITE_API_BASE_URL=https://api.dslite.com.br
DSLITE_API_KEY=
DSLITE_CATALOG_URL=
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=https://marketpilot.example.com/api/v1/integrations/mercadolivre/callback
MERCADOLIVRE_NOTIFICATION_TOKEN=
